# PostgreSQL connection string (Prisma pooled connection)
DATABASE_URL="postgresql://user:password@localhost:5432/fitos"

# PostgreSQL direct connection (used for migrations, e.g. Prisma + connection pooling setups)
DIRECT_URL="postgresql://user:password@localhost:5432/fitos"

# Secret used to sign JWT auth tokens — use a long random string in production
JWT_SECRET="replace-with-a-long-random-secret"

# URL of the deployed/local frontend, used for CORS configuration
FRONTEND_URL="http://localhost:5173"

# Google Gemini API key — used for AI Coach and food photo analysis
GEMINI_API_KEY="your-gemini-api-key-here"
