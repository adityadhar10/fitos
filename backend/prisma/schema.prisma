generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  calorieGoal  Int           @default(2400)
  proteinGoal  Int           @default(160)
  carbGoal     Int           @default(300)
  fatGoal      Int           @default(82)
  createdAt    DateTime      @default(now())

  meals        Meal[]
  workouts     Workout[]
  weightLogs   WeightEntry[]
  dailyMetrics DailyMetric[]
  badges       UserBadge[]
} 

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String   // e.g. "first_workout", "7_day_streak"
  earnedAt  DateTime @default(now())

  @@unique([userId, badgeId])
}


model Meal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  calories    Int
  protein     Int      @default(0)
  carbs       Int      @default(0)
  fats        Int      @default(0)
  createdAt   DateTime @default(now())
}
model Workout {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  muscleGroup String?
  date        DateTime @default(now())
  sets        Set[]
}

model Set {
  id        String  @id @default(uuid())
  workoutId String
  workout   Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  reps      Int
  weight    Float
}

model WeightEntry {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight    Float
  date      DateTime @default(now())
}
model DailyMetric {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  steps     Int      @default(0)
  sleepHours Float   @default(0)

  @@unique([userId, date])
}

