import { useEffect, useState } from "react";
import "../index.css";
import { getWorkouts, addWorkout, deleteWorkout, getWorkoutPRs, getWorkoutSuggestions, getRoutineTemplates } from "../services/api";
import RestTimer from "../components/RestTimer";
import PRCelebrationModal from "../components/PRCelebrationModal";
import RoutineGeneratorModal from "../components/RoutineGeneratorModal";
import OneRepMaxCalculator from "../components/OneRepMaxCalculator";
import WorkoutGuide from "../components/WorkoutGuide";
import WorkoutAnalysisModal from "../components/WorkoutAnalysisModal";
import CollapsibleSection from "../components/CollapsibleSection";
import ExercisePicker from "../components/ExercisePicker";
import { EXERCISES } from "../data/exercises";
import {
  Dumbbell,
  ArrowUpFromLine,
  Footprints,
  Users,
  Trophy,
  Sparkles,
  Play,
  X,
  Calculator,
  TrendingUp,
  Check,
  Trash2,
  Flame,
} from "lucide-react";

interface WorkoutSet {
  id: string;
  reps: number;
  weight: number;
}

interface WorkoutItem {
  id: string;
  name: string;
  muscleGroup?: string | null;
  date: string;
  sets: WorkoutSet[];
}

interface FormExerciseItem {
  id: string;
  name: string;
  muscleGroup: string;
  sets: { reps: string; weight: string }[];
}

interface WorkoutSessionItem {
  sessionId: string;
  name: string;
  date: string;
  exercises: {
    workoutId: string;
    name: string;
    category: string;
    muscle: string;
    sets: WorkoutSet[];
    volume: number;
    totalReps: number;
    topWeight: number;
    isPR: boolean;
  }[];
  totalExercises: number;
  totalSets: number;
  totalReps: number;
  totalVolume: number;
  maxWeight: number;
  prCount: number;
  muscleSummary: string;
}

interface StoredSessionRegistryItem {
  sessionId: string;
  name: string;
  date: string;
  workoutIds: string[];
}

interface PRItem {
  name: string;
  maxWeight: number;
  repsAtMaxWeight: number;
  bestEstimated1RM: number;
  maxSessionVolume: number;
}

interface MuscleRecoveryItem {
  muscle: string;
  status: string;
  score: number;
  hoursAgo: number | null;
  label: string;
}

interface WorkoutSuggestion {
  exercise: string;
  lastSessionDate: string;
  lastTopWeight: number;
  lastAvgReps: number;
  suggestedWeight: number;
  suggestedReps: number;
  recommendation: string;
}

interface RoutineTemplate {
  id: string;
  name: string;
  description: string;
  daysPerWeek: number;
  splitType: string;
  schedule: {
    day: string;
    exercises: {
      name: string;
      sets: number;
      reps: string;
      muscleGroup?: string;
    }[];
  }[];
}

const TEMPLATES = [
  {
    icon: Dumbbell,
    name: "Push Day",
    desc: "Chest · Shoulders · Triceps",
    muscleGroup: "Chest, Shoulders, Triceps",
    exercises: ["Bench Press", "Overhead Press", "Tricep Pushdown", "Lateral Raise"],
  },
  {
    icon: ArrowUpFromLine,
    name: "Pull Day",
    desc: "Back · Biceps · Rear Delts",
    muscleGroup: "Back, Biceps",
    exercises: ["Deadlift", "Pull-Ups", "Barbell Row", "Bicep Curl"],
  },
  {
    icon: Footprints,
    name: "Leg Day",
    desc: "Quads · Hamstrings · Calves",
    muscleGroup: "Legs",
    exercises: ["Squat", "Romanian Deadlift", "Leg Press", "Calf Raise"],
  },
  {
    icon: Users,
    name: "Full Body",
    desc: "All muscle groups",
    muscleGroup: "Full Body",
    exercises: ["Squat", "Bench Press", "Barbell Row", "Overhead Press"],
  },
];

export default function Workout() {
  const [workouts, setWorkouts] = useState<WorkoutItem[]>([]);
  const [prs, setPrs] = useState<PRItem[]>([]);
  const [muscleRecovery, setMuscleRecovery] = useState<MuscleRecoveryItem[]>([]);
  const [suggestions, setSuggestions] = useState<WorkoutSuggestion[]>([]);
  const [celebrationPR, setCelebrationPR] = useState<{ exerciseName: string; weight: number; reps: number } | null>(null);
  const [analysisWorkout, setAnalysisWorkout] = useState<WorkoutItem | null>(null);


  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState<"log" | "routines" | "strength_matrix">("log");
  const [showRoutineModal, setShowRoutineModal] = useState(false);
  const [routineTemplates, setRoutineTemplates] = useState<RoutineTemplate[]>([]);
  const [showForm, setShowForm] = useState(false);
  const [saving, setSaving] = useState(false);
  const [deletingId, setDeletingId] = useState<string | null>(null);
  const [confirmDeleteId, setConfirmDeleteId] = useState<string | null>(null);

  // Multi-exercise Workout Session form state
  const [sessionName, setSessionName] = useState("");
  const [formExercises, setFormExercises] = useState<FormExerciseItem[]>([
    { id: "ex_1", name: "", muscleGroup: "", sets: [{ reps: "", weight: "" }] },
  ]);

  // Load all workouts, PRs, routine templates and suggestions from backend
  const loadData = () => {
    setLoading(true);
    Promise.all([getWorkouts(), getWorkoutPRs(), getRoutineTemplates(), getWorkoutSuggestions()])
      .then(([workoutsRes, prsRes, routinesRes, suggestionsRes]) => {
        setWorkouts(workoutsRes.data.workouts);
        setPrs(prsRes.data.prs || []);
        setMuscleRecovery(prsRes.data.muscleRecovery || []);
        setRoutineTemplates(routinesRes.data.routines || []);
        setSuggestions(suggestionsRes.data.suggestions || []);
      })
      .catch((err) => console.error("Failed to load workouts & PRs:", err))
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    loadData();
  }, []);

  // Form exercise & set management
  const addExerciseToForm = () => {
    setFormExercises((prev) => [
      ...prev,
      {
        id: `ex_${Date.now()}_${Math.random().toString(36).substring(2, 6)}`,
        name: "",
        muscleGroup: "",
        sets: [{ reps: "", weight: "" }],
      },
    ]);
  };

  const removeExerciseFromForm = (exIdx: number) => {
    setFormExercises((prev) => prev.filter((_, i) => i !== exIdx));
  };

  const updateExerciseName = (exIdx: number, name: string, muscleGroup?: string) => {
    setFormExercises((prev) =>
      prev.map((ex, i) =>
        i === exIdx
          ? {
              ...ex,
              name,
              muscleGroup: muscleGroup || ex.muscleGroup,
            }
          : ex
      )
    );
  };

  const updateExerciseMuscle = (exIdx: number, muscleGroup: string) => {
    setFormExercises((prev) =>
      prev.map((ex, i) => (i === exIdx ? { ...ex, muscleGroup } : ex))
    );
  };

  const addSetToExercise = (exIdx: number) => {
    setFormExercises((prev) =>
      prev.map((ex, i) =>
        i === exIdx
          ? { ...ex, sets: [...ex.sets, { reps: "", weight: "" }] }
          : ex
      )
    );
  };

  const removeSetFromExercise = (exIdx: number, setIdx: number) => {
    setFormExercises((prev) =>
      prev.map((ex, i) =>
        i === exIdx
          ? { ...ex, sets: ex.sets.filter((_, s) => s !== setIdx) }
          : ex
      )
    );
  };

  const updateSetField = (
    exIdx: number,
    setIdx: number,
    field: "reps" | "weight",
    value: string
  ) => {
    setFormExercises((prev) =>
      prev.map((ex, i) =>
        i === exIdx
          ? {
              ...ex,
              sets: ex.sets.map((s, si) =>
                si === setIdx ? { ...s, [field]: value } : s
              ),
            }
          : ex
      )
    );
  };

  // Helper to accurately lookup muscle category & primary muscle for any workout
  const getWorkoutMuscleInfo = (workoutName: string, savedMuscleGroup?: string | null) => {
    const normalized = workoutName.trim().toLowerCase();
    const match = EXERCISES.find((ex) => ex.name.toLowerCase() === normalized);
    if (match) {
      return {
        category: match.category,
        muscle: match.muscle,
        badgeText: `${match.category.toUpperCase()} • ${match.muscle.toUpperCase()}`,
      };
    }
    if (savedMuscleGroup && savedMuscleGroup !== "Auto-detect / Optional") {
      return {
        category: savedMuscleGroup,
        muscle: savedMuscleGroup,
        badgeText: savedMuscleGroup.toUpperCase(),
      };
    }
    return {
      category: "Full Body",
      muscle: "Full Body",
      badgeText: "FULL BODY",
    };
  };

  // Smart derivation of session name if none provided
  const deriveSessionName = (categories: string[]): string => {
    const uniqueCats = Array.from(new Set(categories.map((c) => c.toLowerCase())));
    const hasChest = uniqueCats.includes("chest");
    const hasShoulders = uniqueCats.includes("shoulders");
    const hasTriceps = uniqueCats.includes("triceps");
    const hasBack = uniqueCats.includes("back");
    const hasBiceps = uniqueCats.includes("biceps");
    const hasLegs =
      uniqueCats.includes("quadriceps") ||
      uniqueCats.includes("hamstrings") ||
      uniqueCats.includes("glutes") ||
      uniqueCats.includes("calves") ||
      uniqueCats.includes("legs");
    const hasCore =
      uniqueCats.includes("abs / core") ||
      uniqueCats.includes("obliques") ||
      uniqueCats.includes("lower back");

    if ((hasChest && hasShoulders) || (hasChest && hasTriceps) || (hasShoulders && hasTriceps)) {
      return "Push Day";
    }
    if ((hasBack && hasBiceps) || (hasBack && uniqueCats.includes("forearms"))) {
      return "Pull Day";
    }
    if (hasLegs && !hasChest && !hasBack) {
      return "Leg Day";
    }
    if (hasChest && !hasBack && !hasLegs) {
      return "Chest Day";
    }
    if (hasBack && !hasChest && !hasLegs) {
      return "Back Day";
    }
    if (hasShoulders && !hasChest && !hasBack && !hasLegs) {
      return "Shoulder Day";
    }
    if ((hasBiceps || hasTriceps) && !hasChest && !hasBack && !hasLegs) {
      return "Arm Day";
    }
    if (hasCore && uniqueCats.length <= 2) {
      return "Core Workout";
    }
    if (uniqueCats.length >= 3) {
      return "Full Body";
    }
    if (categories.length > 0) {
      return `${categories[0]} Day`;
    }
    return "Workout Session";
  };

  const getStoredSessionsRegistry = (): StoredSessionRegistryItem[] => {
    try {
      const raw = localStorage.getItem("fitos_session_registry");
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  };

  const saveSessionToRegistry = (item: StoredSessionRegistryItem) => {
    try {
      const list = getStoredSessionsRegistry();
      list.unshift(item);
      localStorage.setItem("fitos_session_registry", JSON.stringify(list.slice(0, 100)));
    } catch {
      // ignore
    }
  };



  const formatDate = (iso: string) =>
    new Date(iso).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });

  const calcVolume = (sets: WorkoutSet[]) =>
    sets.reduce((sum, s) => sum + s.reps * s.weight, 0);

  // Group raw workouts into coherent Workout Sessions
  const groupWorkoutsIntoSessions = (
    rawWorkouts: WorkoutItem[],
    prsList: PRItem[]
  ): WorkoutSessionItem[] => {
    if (!rawWorkouts || rawWorkouts.length === 0) return [];

    const registry = getStoredSessionsRegistry();
    const sessions: WorkoutSessionItem[] = [];
    const processedWorkoutIds = new Set<string>();

    // 1. Process explicit sessions from registry
    for (const reg of registry) {
      const matchingWorkouts = rawWorkouts.filter(
        (w) => reg.workoutIds.includes(w.id) && !processedWorkoutIds.has(w.id)
      );
      if (matchingWorkouts.length > 0) {
        matchingWorkouts.forEach((w) => processedWorkoutIds.add(w.id));

        const exercises = matchingWorkouts.map((w) => {
          const info = getWorkoutMuscleInfo(w.name, w.muscleGroup);
          const volume = calcVolume(w.sets);
          const totalReps = w.sets.reduce((sum, s) => sum + s.reps, 0);
          const topWeight = w.sets.length > 0 ? Math.max(...w.sets.map((s) => s.weight)) : 0;
          const isPR = prsList.some(
            (p) =>
              p.name.trim().toLowerCase() === w.name.trim().toLowerCase() &&
              topWeight >= p.maxWeight &&
              topWeight > 0
          );
          return {
            workoutId: w.id,
            name: w.name,
            category: info.category,
            muscle: info.muscle,
            sets: w.sets,
            volume,
            totalReps,
            topWeight,
            isPR,
          };
        });

        const totalVolume = exercises.reduce((sum, e) => sum + e.volume, 0);
        const totalSets = exercises.reduce((sum, e) => sum + e.sets.length, 0);
        const totalReps = exercises.reduce((sum, e) => sum + e.totalReps, 0);
        const maxWeight = Math.max(0, ...exercises.map((e) => e.topWeight));
        const prCount = exercises.filter((e) => e.isPR).length;
        const uniqueCats = Array.from(new Set(exercises.map((e) => e.category.toUpperCase())));
        const muscleSummary = uniqueCats.join(" · ");

        sessions.push({
          sessionId: reg.sessionId,
          name: reg.name || deriveSessionName(exercises.map((e) => e.category)),
          date: reg.date || matchingWorkouts[0].date,
          exercises,
          totalExercises: exercises.length,
          totalSets,
          totalReps,
          totalVolume,
          maxWeight,
          prCount,
          muscleSummary,
        });
      }
    }

    // 2. Group any remaining workouts by calendar date
    const remainingWorkouts = rawWorkouts.filter((w) => !processedWorkoutIds.has(w.id));
    const dateGroups = new Map<string, WorkoutItem[]>();

    for (const w of remainingWorkouts) {
      const dayKey = new Date(w.date).toISOString().slice(0, 10);
      if (!dateGroups.has(dayKey)) {
        dateGroups.set(dayKey, []);
      }
      dateGroups.get(dayKey)!.push(w);
    }

    for (const [dayKey, group] of dateGroups.entries()) {
      const exercises = group.map((w) => {
        const info = getWorkoutMuscleInfo(w.name, w.muscleGroup);
        const volume = calcVolume(w.sets);
        const totalReps = w.sets.reduce((sum, s) => sum + s.reps, 0);
        const topWeight = w.sets.length > 0 ? Math.max(...w.sets.map((s) => s.weight)) : 0;
        const isPR = prsList.some(
          (p) =>
            p.name.trim().toLowerCase() === w.name.trim().toLowerCase() &&
            topWeight >= p.maxWeight &&
            topWeight > 0
        );
        return {
          workoutId: w.id,
          name: w.name,
          category: info.category,
          muscle: info.muscle,
          sets: w.sets,
          volume,
          totalReps,
          topWeight,
          isPR,
        };
      });

      const totalVolume = exercises.reduce((sum, e) => sum + e.volume, 0);
      const totalSets = exercises.reduce((sum, e) => sum + e.sets.length, 0);
      const totalReps = exercises.reduce((sum, e) => sum + e.totalReps, 0);
      const maxWeight = Math.max(0, ...exercises.map((e) => e.topWeight));
      const prCount = exercises.filter((e) => e.isPR).length;
      const uniqueCats = Array.from(new Set(exercises.map((e) => e.category.toUpperCase())));
      const muscleSummary = uniqueCats.join(" · ");
      const sessionName = deriveSessionName(exercises.map((e) => e.category));

      sessions.push({
        sessionId: `day_${dayKey}`,
        name: sessionName,
        date: group[0].date,
        exercises,
        totalExercises: exercises.length,
        totalSets,
        totalReps,
        totalVolume,
        maxWeight,
        prCount,
        muscleSummary,
      });
    }

    return sessions.sort(
      (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
    );
  };

  // Handle saving an entire workout session
  const handleSubmitSession = async (e: React.FormEvent) => {
    e.preventDefault();

    const validExercises = formExercises
      .map((ex) => ({
        ...ex,
        validSets: ex.sets
          .filter((s) => s.reps && s.weight)
          .map((s) => ({ reps: Number(s.reps), weight: Number(s.weight) })),
      }))
      .filter((ex) => ex.name.trim() !== "" && ex.validSets.length > 0);

    if (validExercises.length === 0) return;

    setSaving(true);
    try {
      const nowIso = new Date().toISOString();
      const createdIds: string[] = [];

      let prToCelebrate: { exerciseName: string; weight: number; reps: number } | null = null;

      for (const ex of validExercises) {
        const existingPR = prs.find(
          (p) => p.name.trim().toLowerCase() === ex.name.trim().toLowerCase()
        );
        const maxWeight = Math.max(...ex.validSets.map((s) => s.weight));
        const setAtMax = ex.validSets.find((s) => s.weight === maxWeight);

        if (maxWeight > 0 && (!existingPR || maxWeight > existingPR.maxWeight)) {
          if (!prToCelebrate) {
            prToCelebrate = {
              exerciseName: ex.name,
              weight: maxWeight,
              reps: setAtMax ? setAtMax.reps : 1,
            };
          }
        }

        const res = await addWorkout(ex.name, ex.validSets, ex.muscleGroup || undefined);
        if (res.data?.workout?.id) {
          createdIds.push(res.data.workout.id);
        }
      }

      if (prToCelebrate) {
        setCelebrationPR(prToCelebrate);
      }

      const finalName =
        sessionName.trim() ||
        deriveSessionName(
          validExercises.map((e) => getWorkoutMuscleInfo(e.name, e.muscleGroup).category)
        );

      saveSessionToRegistry({
        sessionId: "session_" + Date.now(),
        name: finalName,
        date: nowIso,
        workoutIds: createdIds,
      });

      setSessionName("");
      setFormExercises([
        { id: "ex_1", name: "", muscleGroup: "", sets: [{ reps: "", weight: "" }] },
      ]);
      setShowForm(false);
      setActiveTab("log");
      loadData();
    } catch (err) {
      console.error("Failed to save workout session:", err);
    } finally {
      setSaving(false);
    }
  };

  // Handle deleting an entire workout session
  

  // Handle deleting a single workout entry
  const handleDelete = async (id: string) => {
    setDeletingId(id);
    setConfirmDeleteId(null);
    try {
      await deleteWorkout(id);
      setWorkouts((ws) => ws.filter((w) => w.id !== id));
    } catch (err) {
      console.error("Failed to delete workout:", err);
    } finally {
      setDeletingId(null);
    }
  };

  // Pre-fill multi-exercise logging form from a routine template
  const handleStartCustomWorkout = (workoutData: {
    name: string;
    muscleGroup: string;
    exercises: string[];
  }) => {
    setSessionName(workoutData.name);
    const populatedExercises: FormExerciseItem[] = workoutData.exercises.map((exName, i) => {
      const info = getWorkoutMuscleInfo(exName);
      return {
        id: `ex_${Date.now()}_${i}`,
        name: exName,
        muscleGroup: info.category,
        sets: [
          { reps: "8", weight: "0" },
          { reps: "8", weight: "0" },
          { reps: "8", weight: "0" },
        ],
      };
    });
    setFormExercises(
      populatedExercises.length > 0
        ? populatedExercises
        : [{ id: "ex_1", name: "", muscleGroup: "", sets: [{ reps: "", weight: "" }] }]
    );
    setShowForm(true);
    setActiveTab("log");
  };



  const groupedSessions = groupWorkoutsIntoSessions(workouts, prs);
  const oneWeekAgo = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);
  const workoutsThisWeek = groupedSessions.filter((s) => new Date(s.date) >= oneWeekAgo).length;

  const freshCount = muscleRecovery.filter(
    (m) => m.status !== "Fatigued" && m.status !== "Recovering"
  ).length;

  return (
    <div className="page-container page-enter">
      {celebrationPR && (
        <PRCelebrationModal
          exerciseName={celebrationPR.exerciseName}
          weight={celebrationPR.weight}
          reps={celebrationPR.reps}
          onClose={() => setCelebrationPR(null)}
        />
      )}

      <div className="page-header">
        <h1>Workout</h1>
        <p>Real-time set logging, gym rest timer, personal records, and recovery tracking.</p>
      </div>

      {/* ── ONBOARDING GUIDE FOR NEW USERS ── */}
      <WorkoutGuide />

      {/* ── TIER 1: CURRENT STATUS & READINESS ── */}
      {(muscleRecovery.length > 0 || prs.length > 0) && (
        <CollapsibleSection
          title="Your Status"
          summary={`${freshCount} muscles ready to train${prs.length > 0 ? ` · ${prs.length} personal record${prs.length !== 1 ? 's' : ''}` : ''}`}
          defaultOpen={false}
        >
          <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
            {muscleRecovery.length > 0 && (
              <div className="section-card">
                <div className="section-header" style={{ marginBottom: 12 }}>
                  <div>
                    <h2 className="section-title">Muscle Recovery Readiness</h2>
                    <p className="subtext" style={{ margin: 0 }}>
                      Shows how rested each muscle group is based on your last workout — train Fresh muscles, rest Sore ones.
                    </p>
                  </div>
                </div>
                <div className="recovery-grid">
                  {muscleRecovery.map((m) => {
                    const statusClass = m.status === "Fatigued" ? "fatigued" : m.status === "Recovering" ? "recovering" : "fresh";
                    const actionableStatus =
                      m.status === "Fatigued"
                        ? "🔴 Rest Needed"
                        : m.status === "Recovering"
                        ? "🟡 1 Day Left"
                        : "🟢 Ready to Train";
                    const advice =
                      m.status === "Fatigued"
                        ? "Still recovering from recent workout"
                        : m.status === "Recovering"
                        ? "Almost recovered, light work only"
                        : m.hoursAgo !== null
                        ? `Fully rested (${m.hoursAgo}h ago)`
                        : "Ready to train";

                    return (
                      <div key={m.muscle} className={`recovery-card ${statusClass}`}>
                        <div className="recovery-header">
                          <strong className="recovery-muscle-name">{m.muscle}</strong>
                          <span className={`recovery-status-badge ${statusClass}`}>
                            {actionableStatus}
                          </span>
                        </div>
                        <span className="recovery-time">
                          {advice}
                        </span>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {prs.length > 0 && (
              <div className="section-card">
                <div className="section-header" style={{ marginBottom: 12 }}>
                  <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
                    <Trophy size={18} color="#facc15" />
                    <div>
                      <h2 className="section-title">Personal Records (PRs)</h2>
                      <p className="subtext" style={{ margin: 0 }}>
                        Your all-time max weight and estimated 1RM benchmarks
                      </p>
                    </div>
                  </div>
                </div>
                <div className="pr-grid">
                  {prs.slice(0, 4).map((pr) => (
                    <div key={pr.name} className="pr-card">
                      <div>
                        <h3 className="pr-title">{pr.name}</h3>
                        <span className="pr-est-1rm">Est. 1RM: {pr.bestEstimated1RM}kg</span>
                      </div>
                      <div style={{ textAlign: "right" }}>
                        <strong className="pr-weight-value">{pr.maxWeight}kg</strong>
                        <span className="pr-reps-count">× {pr.repsAtMaxWeight}r</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </CollapsibleSection>
      )}

      {/* ── TIER 2: WHAT TO DO NEXT (TIMER & LOGGING) ── */}
      <div className="rest-timer-wrapper">
        <RestTimer />
      </div>

      {showRoutineModal && (
        <RoutineGeneratorModal
          onStartWorkout={handleStartCustomWorkout}
          onClose={() => setShowRoutineModal(false)}
        />
      )}

      <div className="section-card">
        <div className="tab-bar">
          <button
            className={`tab-btn ${activeTab === "log" ? "active" : ""}`}
            onClick={() => setActiveTab("log")}
          >
            My Workouts
          </button>
          <button
            className={`tab-btn ${activeTab === "routines" ? "active" : ""}`}
            onClick={() => setActiveTab("routines")}
          >
            AI Routine Splits
          </button>
          <button
            className={`tab-btn ${activeTab === "strength_matrix" ? "active" : ""}`}
            onClick={() => setActiveTab("strength_matrix")}
            style={{ display: "flex", alignItems: "center", gap: 6 }}
          >
            <Calculator size={14} /> 1RM Strength Matrix
          </button>
        </div>

        {/* Dynamic description of the active tab for new users */}
        <div className="tab-explanation-banner">
          {activeTab === "log" && (
            <span>
              <strong>My Workouts:</strong> Log and review your workout history. Pick a quick template below or record your custom sets.
            </span>
          )}
          {activeTab === "routines" && (
            <span>
              <strong>AI Routine Splits:</strong> Get a personalized weekly workout plan generated for you or pick a science-based split.
            </span>
          )}
          {activeTab === "strength_matrix" && (
            <span>
              <strong>1RM Strength Matrix:</strong> Calculate your estimated one-rep max (1RM) and strength percentiles for any lift.
            </span>
          )}
        </div>

        {activeTab === "strength_matrix" && <OneRepMaxCalculator />}

        {activeTab === "routines" && (
          <>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", flexWrap: "wrap", gap: 10, marginBottom: 16 }}>
              <div>
                <h2 className="section-title">Training Splits & AI Generator</h2>
                <p className="subtext" style={{ margin: "2px 0 0 0" }}>
                  Pre-built scientific splits or let FitOS AI build a tailored routine for your gear
                </p>
              </div>
              <button
                type="button"
                className="primary-button"
                onClick={() => setShowRoutineModal(true)}
                style={{ padding: "8px 14px", fontSize: 13, display: "flex", alignItems: "center", gap: 6 }}
              >
                <Sparkles size={14} /> Generate Custom Split with AI
              </button>
            </div>

            <div style={{ display: "flex", flexDirection: "column", gap: 16 }}>
              {routineTemplates.map((r) => (
                <div key={r.id} className="routine-split-card">
                  <div className="routine-split-header">
                    <h3 className="routine-split-title">{r.name}</h3>
                    <span className="routine-split-badge">
                      {r.daysPerWeek} Days / wk ({r.splitType})
                    </span>
                  </div>
                  <p className="routine-split-desc">{r.description}</p>

                  <div className="routine-days-grid">
                    {r.schedule.map((day, dIdx) => (
                      <div key={dIdx} className="routine-day-card">
                        <div>
                          <strong className="routine-day-title">{day.day}</strong>
                          <div className="routine-day-exercises">
                            {day.exercises.map((ex, eIdx) => (
                              <span key={eIdx} className="routine-day-exercise-item">
                                • {ex.name} ({ex.sets} × {ex.reps})
                              </span>
                            ))}
                          </div>
                        </div>

                        <button
                          type="button"
                          className="tab-btn active"
                          onClick={() =>
                            handleStartCustomWorkout({
                              name: day.day,
                              muscleGroup: day.exercises[0]?.muscleGroup || "Full Body",
                              exercises: day.exercises.map((e) => e.name),
                            })
                          }
                          style={{ width: "100%", padding: "6px", fontSize: 11, fontWeight: 700, borderRadius: 6, cursor: "pointer", display: "flex", alignItems: "center", justifyContent: "center", gap: 4 }}
                        >
                          <Play size={12} /> Start This Workout
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </>
        )}

        {activeTab === "log" && (
          <>
            {!showForm && (
              <div style={{ marginBottom: 20 }}>
                <h2 style={{ fontSize: 15, fontWeight: 700, marginBottom: 10 }}>Quick Start Templates</h2>
                <div className="quick-template-grid">
                  {TEMPLATES.map((template) => {
                    const Icon = template.icon;
                    return (
                      <button
                        key={template.name}
                        type="button"
                        onClick={() =>
                          handleStartCustomWorkout({
                            name: template.name,
                            muscleGroup: template.muscleGroup,
                            exercises: template.exercises,
                          })
                        }
                        className="quick-template-btn"
                      >
                        <Icon size={18} color="#4ade80" />
                        <strong className="quick-template-name">{template.name}</strong>
                        <span className="quick-template-desc">{template.desc}</span>
                      </button>
                    );
                  })}
                </div>
              </div>
            )}

            <div className="section-header" style={{ marginTop: 0 }}>
              <div>
                <div style={{ display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap" }}>
                  <h2 style={{ margin: 0 }}>Recent Workouts</h2>
                  {workoutsThisWeek > 0 && (
                    <span className="section-header-summary">
                      {workoutsThisWeek} workout{workoutsThisWeek !== 1 ? "s" : ""} this week
                    </span>
                  )}
                </div>
                <p className="subtext" style={{ margin: "2px 0 0 0" }}>
                  Track your training history, progressive overload, and personal benchmarks
                </p>
              </div>
              <button
                className="action-btn"
                onClick={() => setShowForm((s) => !s)}
              >
                {showForm ? "Cancel" : "+ Log Workout"}
              </button>
            </div>

            {showForm && (
              <form onSubmit={handleSubmitSession} className="workout-form">

                <input
                  type="text"
                  placeholder="Workout Session Name (Optional)"
                  value={sessionName}
                  onChange={(e) => setSessionName(e.target.value)}
                  className="workout-input"
                />

                {formExercises.map((exercise, exIdx) => (
                  <div key={exercise.id} className="exercise-form-card">

                    <div className="exercise-form-header">
                      <h3>Exercise {exIdx + 1}</h3>

                      {formExercises.length > 1 && (
                        <button
                          type="button"
                          className="remove-set-btn"
                          onClick={() => removeExerciseFromForm(exIdx)}
                        >
                          <X size={14} />
                        </button>
                      )}
                    </div>

                    <ExercisePicker
                      value={exercise.name}
                      selectedCategory={exercise.muscleGroup}
                      onSelect={(selected) => {
                        updateExerciseName(
                          exIdx,
                          selected.name,
                          selected.category
                        );
                      }}
                    />

                    <select
                      value={exercise.muscleGroup}
                      onChange={(e) =>
                        updateExerciseMuscle(exIdx, e.target.value)
                      }
                      className="workout-select-field"
                    >
                      <option value="">
                        Target Muscle Group (Auto-detect / Optional)
                      </option>
                      <option value="Chest">Chest</option>
                      <option value="Back">Back</option>
                      <option value="Shoulders">Shoulders</option>
                      <option value="Biceps">Biceps</option>
                      <option value="Triceps">Triceps</option>
                      <option value="Forearms">Forearms</option>
                      <option value="Quadriceps">Quadriceps</option>
                      <option value="Hamstrings">Hamstrings</option>
                      <option value="Glutes">Glutes</option>
                      <option value="Calves">Calves</option>
                      <option value="Abs / Core">Abs / Core</option>
                      <option value="Obliques">Obliques</option>
                      <option value="Lower Back">Lower Back</option>
                      <option value="Full Body">Full Body</option>
                    </select>

                    {exercise.sets.map((set, setIdx) => (
                      <div key={setIdx} className="set-row">

                        <input
                          placeholder="Reps"
                          type="number"
                          min="1"
                          value={set.reps}
                          onChange={(e) =>
                            updateSetField(
                              exIdx,
                              setIdx,
                              "reps",
                              e.target.value
                            )
                          }
                        />

                        <input
                          placeholder="Weight (kg)"
                          type="number"
                          min="0"
                          step="0.5"
                          value={set.weight}
                          onChange={(e) =>
                            updateSetField(
                              exIdx,
                              setIdx,
                              "weight",
                              e.target.value
                            )
                          }
                        />

                        {exercise.sets.length > 1 && (
                          <button
                            type="button"
                            className="remove-set-btn"
                            onClick={() =>
                              removeSetFromExercise(exIdx, setIdx)
                            }
                          >
                            <X size={14} />
                          </button>
                        )}

                      </div>
                    ))}

                    <button
                      type="button"
                      className="add-set-btn"
                      onClick={() => addSetToExercise(exIdx)}
                    >
                      + Add Set
                    </button>

                  </div>
                ))}

                <button
                  type="button"
                  className="add-set-btn"
                  onClick={addExerciseToForm}
                >
                  + Add Exercise
                </button>

                <button
                  className="primary-button"
                  type="submit"
                  disabled={saving}
                >
                  {saving ? "Saving..." : "Save Workout"}
                </button>

              </form>
            )}

            <div className="workout-list">
              {loading && (
                <>
                  {[1, 2].map((i) => (
                    <div key={i} className="workout-card">
                      <div className="skeleton skeleton-text" style={{ marginBottom: 8 }} />
                      <div className="skeleton skeleton-text short" />
                    </div>
                  ))}
                </>
              )}
              {!loading && workouts.length === 0 && (
                <div className="workout-empty-card">
                  <div className="workout-empty-icon-box">
                    <Dumbbell size={32} color="#4ade80" />
                  </div>
                  <h3 className="workout-empty-title">No workouts logged yet</h3>
                  <p className="workout-empty-desc">
                    Start your first workout and your progress will appear here.
                  </p>
                  <button
                    type="button"
                    className="primary-button"
                    onClick={() => setShowForm(true)}
                    style={{ marginTop: 8 }}
                  >
                    + Log Workout
                  </button>
                </div>
              )}
              {!loading &&
                workouts.map((workout, idx) => {
                  const volume = calcVolume(workout.sets);
                  const totalSets = workout.sets.length;
                  const totalReps = workout.sets.reduce((sum, s) => sum + s.reps, 0);
                  const topWeight =
                    workout.sets.length > 0
                      ? Math.max(...workout.sets.map((s) => s.weight))
                      : 0;

                  // Precise muscle & category lookup
                  const muscleInfo = getWorkoutMuscleInfo(
                    workout.name,
                    workout.muscleGroup
                  );

                  // Compare with older session of the same exercise
                  const prevWorkout = workouts
                    .slice(idx + 1)
                    .find(
                      (w) =>
                        w.name.trim().toLowerCase() ===
                        workout.name.trim().toLowerCase()
                    );

                  let progressBadge: string | null = null;
                  if (prevWorkout && prevWorkout.sets.length > 0) {
                    const prevVol = calcVolume(prevWorkout.sets);
                    const prevTop = Math.max(
                      ...prevWorkout.sets.map((s) => s.weight)
                    );
                    if (topWeight > prevTop && prevTop > 0) {
                      progressBadge = `↑ +${topWeight - prevTop}kg`;
                    } else if (volume > prevVol && prevVol > 0) {
                      const volPct = Math.round(
                        ((volume - prevVol) / prevVol) * 100
                      );
                      if (volPct > 0) {
                        progressBadge = `↑ +${volPct}% vol`;
                      }
                    }
                  }

                  // Check if this workout set equals or beats PR
                  const isPR = prs.some(
                    (p) =>
                      p.name.trim().toLowerCase() ===
                        workout.name.trim().toLowerCase() &&
                      topWeight >= p.maxWeight &&
                      topWeight > 0
                  );

                  return (
                    <div
                      key={workout.id}
                      className={`workout-card ${isPR ? "is-pr" : ""}`}
                    >
                      <div className="workout-card-header">
                        <div className="workout-card-left">
                          <div className="workout-icon-box">
                            <Dumbbell size={18} />
                          </div>
                          <div>
                            <div className="workout-name-wrap">
                              <h3 className="workout-exercise-name">
                                {workout.name}
                              </h3>
                              {isPR && (
                                <span className="workout-pr-badge">
                                  <Flame size={11} /> New PR
                                </span>
                              )}
                            </div>
                            <div className="workout-sub-info">
                              <span className="workout-muscle-badge">
                                {muscleInfo.badgeText}
                              </span>
                              <span className="workout-bullet">•</span>
                              <span className="workout-date-text">
                                {formatDate(workout.date)}
                              </span>
                            </div>
                          </div>
                        </div>

                        <div className="workout-card-actions">
                          <span className="workout-status-completed">
                            <Check size={12} /> Completed
                          </span>

                          {confirmDeleteId === workout.id ? (
                            <div className="workout-delete-confirm-wrap">
                              <button
                                className="workout-delete-btn confirm"
                                onClick={() => handleDelete(workout.id)}
                                disabled={deletingId === workout.id}
                              >
                                {deletingId === workout.id
                                  ? "Deleting…"
                                  : "Confirm?"}
                              </button>
                              <button
                                className="workout-delete-btn cancel"
                                onClick={() => setConfirmDeleteId(null)}
                              >
                                Cancel
                              </button>
                            </div>
                          ) : (
                            <button
                              className="workout-delete-btn"
                              onClick={() => setConfirmDeleteId(workout.id)}
                              disabled={deletingId === workout.id}
                              title="Delete workout entry"
                            >
                              <Trash2 size={13} />
                              <span>Delete</span>
                            </button>
                          )}
                        </div>
                      </div>

                      <div className="workout-stats-grid">
                        <div className="workout-stat-item">
                          <span className="workout-stat-label">SETS</span>
                          <strong className="workout-stat-value">
                            {totalSets}
                          </strong>
                        </div>
                        <div className="workout-stat-item">
                          <span className="workout-stat-label">TOTAL REPS</span>
                          <strong className="workout-stat-value">
                            {totalReps}
                          </strong>
                        </div>
                        <div className="workout-stat-item">
                          <span className="workout-stat-label">TOP WEIGHT</span>
                          <strong className="workout-stat-value">
                            {topWeight} kg
                          </strong>
                        </div>
                        <div className="workout-stat-item">
                          <span className="workout-stat-label">VOLUME</span>
                          <strong className="workout-stat-value accent">
                            {volume.toLocaleString()} kg
                          </strong>
                        </div>
                        {progressBadge && (
                          <div className="workout-stat-progress">
                            <span className="workout-progress-chip">
                              {progressBadge}
                            </span>
                          </div>
                        )}
                      </div>

                      <div className="sets-list">
                        {workout.sets.map((set, sIdx) => (
                          <span key={set.id || sIdx} className="set-badge">
                            Set {sIdx + 1}: {set.reps} × {set.weight}kg
                          </span>
                        ))}
                      </div>

                      <button
                        type="button"
                        className="action-btn"
                        onClick={() => setAnalysisWorkout(workout)}
                        style={{
                          marginTop: 12,
                          width: "100%",
                          justifyContent: "center",
                          display: "flex",
                          alignItems: "center",
                          gap: 6,
                        }}
                      >
                        ✨ Analyze Workout
                      </button>
                    </div>
                  );
                })}
            </div>
          </>
        )}
      </div>

      {/* ── TIER 3: TRAINING ANALYSIS & SUGGESTIONS ── */}
      {suggestions.length > 0 && (
        <CollapsibleSection
          title="Training Insights"
          summary={`${suggestions.length} suggestion${suggestions.length !== 1 ? "s" : ""} based on your recent workouts`}
          defaultOpen={false}
        >
          <div className="section-header" style={{ marginBottom: 12 }}>
            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
              <TrendingUp size={18} color="#4ade80" />
              <div>
                <h2 className="section-title">Progressive Overload Suggestions</h2>
                <p className="subtext" style={{ margin: 0 }}>
                  Data-driven targets for your next session, based on your last workout per exercise
                </p>
              </div>
            </div>
          </div>
          <div className="suggestion-list">
            {suggestions.slice(0, 5).map((s) => (
              <div key={s.exercise} className="suggestion-card">
                <div className="suggestion-header">
                  <strong className="suggestion-exercise-name">{s.exercise}</strong>
                  <span className="suggestion-target-value">
                    {s.suggestedWeight}kg × {s.suggestedReps}
                  </span>
                </div>
                <p className="suggestion-rec-text">{s.recommendation}</p>
              </div>
            ))}
          </div>
        </CollapsibleSection>
      )}
      {analysisWorkout && (
        <WorkoutAnalysisModal
          sessionName={analysisWorkout.name}
          exercises={[
            {
              name: analysisWorkout.name,
              sets: analysisWorkout.sets.map((set) => ({
                reps: Number(set.reps),
                weight: Number(set.weight),
              })),
            },
          ]}
          onClose={() => setAnalysisWorkout(null)}
        />
      )}
    </div>
  );
}
